"""Account-scoped privacy controls. No provider deletion is claimed by local deletion."""
import copy
import hashlib
import hmac
import json
import time
from urllib.parse import urlsplit
from uuid import uuid4
# card-service-privacy:v1
try:
    from card_service import privacy_export as card_privacy_export, privacy_delete_records as card_privacy_delete_records
except ModuleNotFoundError:
